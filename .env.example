DATABASE_URL=postgres://postgres:postgres@localhost:5432/phantom_auth
PORT=3001

# Required. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# 32 random bytes as 64 hex characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=

CORS_ORIGIN=http://localhost:3000
# Set to true only when running behind a trusted reverse proxy, so the client IP comes from X-Forwarded-For.
TRUST_PROXY=false

# Lets other backend services (the wallet) call /internal routes. Leave empty to keep them off.
# At least 24 characters.
# SERVICE_API_KEY=

# Optional tuning (defaults shown)
# ACCESS_TTL_SEC=900
# REFRESH_TTL_DAYS=30
# MAX_FAILED_ATTEMPTS=5
# LOCKOUT_MINUTES=15
# RATE_LIMIT_PER_MINUTE=60
# IP_FAILED_LOGIN_MAX=10
# WHITELIST_DELAY_HOURS=24
# ARGON2_MEMORY_KIB=19456
# ARGON2_TIME_COST=2
